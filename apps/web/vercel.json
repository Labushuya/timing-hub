{
  "framework": "sveltekit",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@timing-hub/web",
  "outputDirectory": ".svelte-kit/output",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "headers": [
    { "source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}] },
    { "source": "/manifest.webmanifest", "headers": [{"key": "Cache-Control", "value": "no-cache"}] },
    { "source": "/_app/immutable/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}] }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.timinghub.de/v1/$1" }
  ]
}
