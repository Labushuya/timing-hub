{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@timing-hub/scoring-engine": ["../../packages/scoring-engine/src/index.ts"],
      "@timing-hub/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/scoring-engine/src/**/*",
    "../../packages/shared-types/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
