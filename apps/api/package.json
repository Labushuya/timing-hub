{
  "name": "@timing-hub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "cp -r src/db/migrations/*.sql dist/db/migrations/ 2>/dev/null || true",
    "start": "node dist/server.js",
    "start:prod": "node -r source-map-support/register dist/server.js",
    "migrate": "tsx src/db/migrations/migrate.ts up",
    "migrate:prod": "node dist/db/migrations/migrate.js up",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:unit": "vitest run --reporter=verbose tests/unit",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5432/timing_hub_test} vitest run --reporter=verbose tests/integration"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@sentry/node": "^8.38.0",
    "@sentry/profiling-node": "^8.55.2",
    "argon2": "^0.41.1",
    "bullmq": "^5.13.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "node-pg-migrate": "^7.7.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
