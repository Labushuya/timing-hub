# === Timing Hub Production Config ===
# Copy to .env.prod and fill in values
# Generate secrets with: openssl rand -hex 32

# Database
POSTGRES_DB=timing_hub
POSTGRES_USER=timing_hub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# API
DATABASE_URL=postgresql://timing_hub:CHANGE_ME_STRONG_PASSWORD@postgres:5432/timing_hub
REDIS_URL=redis://redis:6379
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
MASTER_ADMIN_TOKEN=CHANGE_ME_RUN_openssl_rand_hex_32
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://timinghub.de,https://www.timinghub.de
SENTRY_DSN=

# Web (used during docker build)
PUBLIC_API_URL=https://api.timinghub.de
PUBLIC_WS_URL=wss://api.timinghub.de/ws
